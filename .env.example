# Copy this file to .env (in the project root) and fill in your own values.
# Never commit the real .env file.

# Port the backend server listens on. Optional — defaults to 3000.
PORT=3000

# Required to access the staff dashboard (HTTP Basic Auth). The server
# rejects all /api/staff/* requests until both are set — pick your own
# values, there is no default.
STAFF_USERNAME=
STAFF_PASSWORD=

# AI API configuration — reserved for future use.
# The backend does not call an AI provider yet (see backend/server.js,
# getMockReply), so these are not read by any code yet.
OPENAI_API_KEY=
OPENAI_MODEL=
