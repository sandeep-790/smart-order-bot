# Copy this file to .env (in the project root) and fill in your own values.
# Never commit the real .env file.

# Port the backend server listens on. Optional — defaults to 3000.
PORT=3000

# Required to access the staff dashboard (HTTP Basic Auth). The server
# rejects all /api/staff/* requests until both are set — pick your own
# values, there is no default.
STAFF_USERNAME=
STAFF_PASSWORD=

# AI provider for the chat tab (POST /api/chat). Any OpenAI-compatible
# chat completions API works — the defaults below are Google Gemini's free
# tier, which needs no credit card. Get a key at
# https://aistudio.google.com/apikey and paste it into AI_API_KEY.
# Google deprecates dated model names fairly often (gemini-2.0-flash and
# gemini-2.5-flash/-lite were already gone as of 2026-08) — "-latest"
# aliases like the one below auto-point at whatever's currently live, so
# prefer those over a dated name. If this ever 404s, list what your key
# can actually access:
#   curl -s https://generativelanguage.googleapis.com/v1beta/openai/models \
#     -H "Authorization: Bearer $AI_API_KEY"
# Without AI_API_KEY set, /api/chat replies with a clear "not configured"
# message instead of erroring.
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest

# Text-to-speech for RoboCap's chat replies (POST /api/tts), via Sarvam AI's
# Bulbul model — natural Indian-English voices, free tier is 1,000 credits
# with no credit card required. Get a key at https://dashboard.sarvam.ai/
# (sign up, then create an API key from the dashboard) and paste it into
# SARVAM_API_KEY. SARVAM_TTS_SPEAKER/SARVAM_TTS_MODEL are optional — see
# https://docs.sarvam.ai for the full voice list (male: shubh, aditya,
# rahul...; female: priya, roopa, neha...). Without SARVAM_API_KEY set,
# /api/tts returns a clear "not configured" error and the frontend just
# stays silent instead of erroring.
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_MODEL=bulbul:v3
