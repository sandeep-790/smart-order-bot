# Copy this file to .env (in the project root) and fill in your own values.
# Never commit the real .env file.

# Port the backend server listens on. Optional — defaults to 3000.
PORT=3000

# Required to access the staff dashboard (HTTP Basic Auth). The server
# rejects all /api/staff/* requests until both are set — pick your own
# values, there is no default.
STAFF_USERNAME=
STAFF_PASSWORD=

# Google's native Gemini API — used directly (generateContent), not through
# an OpenAI-compatible shim. Powers the chat tab's "thinking" (POST
# /api/chat). Get a key at https://aistudio.google.com/apikey — the free
# tier needs no credit card.
#
# LIVE_MODEL is the text model used for chat replies and tool-calling.
# Google deprecates dated model names fairly often — "-latest" aliases
# (e.g. gemini-flash-lite-latest) auto-point at whatever's currently live,
# so prefer those over a dated name. If this ever 404s, list what your key
# can actually access:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
#
# Without GOOGLE_API_KEY set, /api/chat replies with a clear "not
# configured" message instead of erroring.
GOOGLE_API_KEY=
LIVE_MODEL=gemini-flash-lite-latest

# Text-to-speech for RoboCap's chat replies — Sarvam AI's Bulbul model
# (natural Indian-English voices). Get a key at https://www.sarvam.ai.
# SARVAM_TTS_SPEAKER is a lowercase speaker name (e.g. shubh, ritu).
# SARVAM_TTS_MODEL defaults to bulbul:v3.
#
# Without SARVAM_API_KEY set, /api/tts stays silent instead of erroring.
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_MODEL=bulbul:v3
